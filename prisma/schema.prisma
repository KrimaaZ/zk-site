generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  ingredients  String
  instructions String
  prepTime     Int
  cookTime     Int
  servings     Int
  category     String
  imageUrl     String?
  createdAt    DateTime @default(now())
}

model MealPlan {
  id        Int    @id @default(autoincrement())
  date      String @unique
  breakfast Int?
  lunch     Int?
  dinner    Int?
}

model WorkoutSession {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  date      String
  exercises String
  notes     String?
  createdAt DateTime @default(now())
}

model Goal {
  id        String   @id @default(cuid())
  tab       String
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model HabitEntry {
  id       Int     @id @default(autoincrement())
  date     String
  habitKey String
  done     Boolean @default(true)

  @@unique([date, habitKey])
}

model WorkoutSet {
  id       Int      @id @default(autoincrement())
  logKey   String
  reps     Int
  kg       Float
  loggedAt DateTime @default(now())
}
